# =============================================================================
# API KEYS
# =============================================================================

# OpenAI API key (required) — get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic API key (optional) — get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: explicitly set provider (auto-detected if not set)
# If both API keys are present and LLM_PROVIDER is not set, Anthropic will be used by default
# LLM_PROVIDER=openai
# LLM_PROVIDER=anthropic

# =============================================================================
# MODEL CONFIGURATION (optional — defaults shown)
# =============================================================================

# Model used for coding tasks (theme YES/NO, non-verbal cues)
# LLM_MODEL=gpt-5-mini

# Model used for theme extraction (Activities D and E — inductive coding)
# A reasoning model is recommended here for higher quality output
# THEME_EXTRACTION_MODEL=gpt-5

# Reasoning effort for theme extraction: low | medium | high
# THEME_EXTRACTION_REASONING_EFFORT=high

# Embedding model used for all vector representations
# text-embedding-3-large produces 1536-dimensional vectors
# EMBEDDING_MODEL=text-embedding-3-large

# =============================================================================
# TRANSCRIPT LANGUAGE
# =============================================================================

# Language code for the transcript to analyze (Activity A onward).
# This controls which transcript file is loaded and the language of
# content/quotes in all outputs. Report structure is always in English.
#
# Supported out of the box:
#   en  →  data/sample_transcripts/sample_english.md
#   es  →  data/sample_transcripts/sample_spanish.md
#
# To use another language, add a file at:
#   data/sample_transcripts/sample_<lang>.md
# and set the matching code here (e.g. TRANSCRIPT_LANGUAGE=fr)
#
# Note: embeddings work across languages — you can code in the original
# language without translating first (see Activity A in session_03).
TRANSCRIPT_LANGUAGE=en
